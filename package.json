{
    "name": "@333eco/firebase-bridge",
    "version": "0.1.1",
    "description": "Accept \"Log in with HeartBank\" in a Firebase app: verify a login.333.eco ID token and mint YOUR project's Firebase custom token, with how the person logged in (passkey, email or SMS code) copied into claims your rules can require. ES256 only; refuses wrong-app, wrong-issuer, expired, replayed and forged tokens. CC0.",
    "license": "CC0-1.0 OR Apache-2.0",
    "author": "Thon Ly",
    "homepage": "https://github.com/333eco/firebase-bridge.333.eco#readme",
    "repository": { "type": "git", "url": "git+https://github.com/333eco/firebase-bridge.333.eco.git" },
    "keywords": ["heartbank", "openid-connect", "oidc", "firebase", "custom-token", "passkey", "webauthn", "amr", "sso", "cc0"],
    "type": "module",
    "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./package.json": "./package.json" },
    "files": ["dist", "README.md", "LICENSE", "LICENSE-CC0", "LICENSE-APACHE"],
    "sideEffects": false,
    "engines": { "node": ">=20" },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "test": "npm run build && node --test test/bridge.test.mjs",
        "prepublishOnly": "npm test"
    },
    "dependencies": { "jose": "6.2.12" },
    "devDependencies": { "typescript": "5.9.3" }
}
